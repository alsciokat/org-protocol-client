{
  "manifest_version": 3,
  "name": "Org Protocol Client",
  "version": "0.1.0",
  "description": "Client for calling various `org-protocol`s for Emacs.",
  "homepage_url": "https://github.com/alsciokat/org-capture-extension",

  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },

  "permissions": ["activeTab", "storage", "scripting"],

  "web_accessible_resources": [
    {
      "resources": [
        "src/capture.js",
        "src/menu.js",
        "src/settings.js",
        "icons/org-mode-unicorn.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_icon": "icons/org-mode-unicorn.png"
  },

  "commands": {
    "_execute_action": {
      "description": "Capture current page with org-capture",
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      }
    }
  }
}
